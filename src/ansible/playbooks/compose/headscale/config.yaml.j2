server_url: {{ ('https://' ~ headscale_hostname) | to_json }}
listen_addr: "0.0.0.0:8080"
metrics_listen_addr: "127.0.0.1:9090"
grpc_listen_addr: "127.0.0.1:50443"
unix_socket: /var/lib/headscale/headscale.sock
unix_socket_permission: "0600"
node:
  ephemeral:
    inactivity_timeout: 30m
tls_letsencrypt_hostname: ""
tls_cert_path: ""
tls_key_path: ""
noise:
  private_key_path: /var/lib/headscale/noise_private.key
database:
  type: sqlite3
  sqlite:
    path: /var/lib/headscale/db.sqlite
policy:
  mode: database
prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential
derp:
  server:
    enabled: true
    automatically_add_embedded_derp_region: true
    region_id: 999
    region_code: headscale
    region_name: Headscale
    stun_listen_addr: "0.0.0.0:3478"
    private_key_path: /var/lib/headscale/derp_server_private.key
    ipv4: {{ public_ipv4 | to_json }}
    ipv6: {{ public_ipv6 | to_json }}
  urls: []
  paths: []
  auto_update_enabled: false
dns:
  nameservers:
    global:
      - 2606:4700:4700::1111
      - 2606:4700:4700::1001
      - 1.1.1.1
      - 1.0.0.1
    split:
      headscale.levizitting.com:
        - 2606:4700:4700::1111
        - 2606:4700:4700::1001
        - 1.1.1.1
        - 1.0.0.1
      x86-vps-node-01.levizitting.com:
        - 2606:4700:4700::1111
        - 2606:4700:4700::1001
        - 1.1.1.1
        - 1.0.0.1
      levizitting.com:
        - 10.255.255.1
  override_local_dns: false
  magic_dns: true
  base_domain: headnet.levizitting.com
  extra_records_path: /etc/headscale-dns/extra-records.json
log:
  format: text
