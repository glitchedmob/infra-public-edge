http:
  routers:
    lz-http-forward:
      entryPoints: [web]
      rule: >-
        HostRegexp(`^([a-z0-9-]+\.)*levizitting\.com$`)
        && !Host({{ headscale_hostname | to_json }})
        && !Host({{ uptime_kuma_hostname | to_json }})
        && !Host(`levizitting.com`)
      priority: 100
      service: lz-ingress
    sgfdevs-http-forward:
      entryPoints: [web]
      rule: >-
        HostRegexp(`^([a-z0-9-]+\.)*sgf\.dev$`)
        || HostRegexp(`^([a-z0-9-]+\.)*methodconf\.com$`)
        || HostRegexp(`^([a-z0-9-]+\.)*hack4goodsgf\.com$`)
      priority: 100
      service: sgfdevs-ingress
    headscale:
      rule: {{ ('Host(' ~ (headscale_hostname | to_json) ~ ')') | to_json }}
      priority: 10
      entryPoints:
        - websecure
      service: headscale
      middlewares:
        - strip-true-client-ip
      tls:
        certResolver: letsencrypt
    headplane:
      rule: {{ ('Host(' ~ (headscale_hostname | to_json) ~ ') && (Path(`/admin`) || PathPrefix(`/admin/`))') | to_json }}
      priority: 100
      entryPoints:
        - websecure
      service: headplane
      tls:
        certResolver: letsencrypt
    uptime-kuma:
      rule: {{ ('Host(' ~ (uptime_kuma_hostname | to_json) ~ ')') | to_json }}
      entryPoints:
        - websecure
      service: uptime-kuma
      tls:
        certResolver: letsencrypt

  middlewares:
    strip-true-client-ip:
      headers:
        customRequestHeaders:
          True-Client-IP: ""

  services:
    lz-ingress:
      loadBalancer:
        passHostHeader: true
        servers:
{% if lz_tailnet_ingress_enabled | bool %}
          - url: http://traefik-lz-k3s-01.headnet.levizitting.com:8000
          - url: http://traefik-lz-k3s-02.headnet.levizitting.com:8000
          - url: http://traefik-lz-k3s-03.headnet.levizitting.com:8000
{% else %}
          - url: http://lz-k3s.levizitting.com:80
{% endif %}
    sgfdevs-ingress:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: http://sgfdevs-k3s.levizitting.com:80
    headscale:
      loadBalancer:
        servers:
          - url: http://headscale:8080
    headplane:
      loadBalancer:
        servers:
          - url: http://headplane:3000
    uptime-kuma:
      loadBalancer:
        servers:
          - url: http://uptime-kuma:3001

tcp:
  routers:
    visitor-ip-probe:
      entryPoints: [websecure]
      rule: HostSNI(`visitor-ip-probe.levizitting.com`)
      priority: 1000
      service: visitor-ip-probe
      tls:
        passthrough: true
    lz-https-passthrough:
      entryPoints: [websecure]
      rule: >-
        HostSNIRegexp(`^([a-z0-9-]+\.)*levizitting\.com$`)
        && !HostSNI({{ headscale_hostname | to_json }})
        && !HostSNI({{ uptime_kuma_hostname | to_json }})
        && !HostSNI(`levizitting.com`)
      service: lz-ingress
      tls:
        passthrough: true
    sgfdevs-https-passthrough:
      entryPoints: [websecure]
      rule: >-
        HostSNIRegexp(`^([a-z0-9-]+\.)*sgf\.dev$`)
        || HostSNIRegexp(`^([a-z0-9-]+\.)*methodconf\.com$`)
        || HostSNIRegexp(`^([a-z0-9-]+\.)*hack4goodsgf\.com$`)
      service: sgfdevs-ingress
      tls:
        passthrough: true
  services:
    visitor-ip-probe:
      loadBalancer:
        proxyProtocol:
          version: 2
        # IPv4 pins keep the sender in the receiver's trusted IPv4 scope (100.64.0.10/32).
        servers:
          - address: 100.64.0.35:8443
          - address: 100.64.0.34:8443
          - address: 100.64.0.37:8443
    lz-ingress:
      loadBalancer:
{% if lz_tailnet_ingress_enabled | bool %}
        proxyProtocol:
          version: 2
        servers:
          - address: traefik-lz-k3s-01.headnet.levizitting.com:8443
          - address: traefik-lz-k3s-02.headnet.levizitting.com:8443
          - address: traefik-lz-k3s-03.headnet.levizitting.com:8443
{% else %}
        servers:
          - address: lz-k3s.levizitting.com:443
{% endif %}
    sgfdevs-ingress:
      loadBalancer:
        servers:
          - address: sgfdevs-k3s.levizitting.com:443
